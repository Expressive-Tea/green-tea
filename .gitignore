# Local specs & plans — not committed
.specs/

# Per-developer agent state: local settings and tool locks, one directory per assistant. Nothing
# here is shared configuration — `.serena/` even ships its own .gitignore. A repository-wide
# `.claude/settings.json` is a real convention and would need a `!` line here to be committable;
# none exists today, so this stays a blanket ignore rather than a rule for a file nobody wrote.
.claude/
.serena/

# Node
node_modules/
dist/
coverage/
*.log

# Env
.env
.env.*


# Edge (Miniflare) test bundle artifact
test/edge/_worker.mjs

# Bun writes this on `bun install`, and nothing here consumes it: `npm run test:bun` runs
# `bun test` against the node_modules npm installed, which package-lock.json already pins.
# deno.lock IS tracked, and that asymmetry is deliberate — the Deno tests import `npm:` and
# `jsr:` specifiers that Deno resolves against registries, so only a lockfile makes them
# reproducible. Bun resolves the same package.json npm does.
bun.lock
