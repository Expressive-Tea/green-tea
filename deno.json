{
  "name": "@green-tea/core",
  "version": "26.8.0-beta.1",
  "license": "MIT",
  // JSR serves TypeScript source, not the tsup build, so these point at `src/` where npm's
  // `exports` point at `dist/`. Same four entry points on purpose: a docs example that imports
  // `@green-tea/core/bun` has to work whichever registry the reader installed from.
  "exports": {
    ".": "./src/index.ts",
    "./deno": "./src/deno.ts",
    "./bun": "./src/bun.ts",
    "./edge": "./src/edge.ts"
  },
  "publish": {
    "include": ["src", "README.md", "CHANGELOG.md", "LICENSE", "deno.json"]
  },
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "lib": ["deno.window", "deno.ns"]
  },
  "unstable": ["sloppy-imports"],
  "imports": {
    "http": "node:http",
    "https": "node:https",
    "crypto": "node:crypto",
    "events": "node:events",
    "stream": "node:stream"
  },
  "lint": { "exclude": ["dist", "node_modules"] }
}
