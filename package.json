{
  "name": "@green-tea/core",
  "version": "0.0.0",
  "description": "Declarative, type-safe HTTP framework. The pipeline is a graph, not a middleware chain.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:dev": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:bench": "tsc --noEmit -p bench/tsconfig.json",
    "bench": "tsx bench/run.ts"
  },
  "dependencies": {
    "reflect-metadata": "0.2.2"
  },
  "peerDependencies": {
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/platform-fastify": "^11.1.27",
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.6",
    "@types/node": "^18.19.0",
    "@types/ws": "^8.18.1",
    "autocannon": "^8.0.0",
    "express": "^5.2.1",
    "fastify": "^5.10.0",
    "graphql": "^16.9.0",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "ws": "^8.21.0"
  }
}
