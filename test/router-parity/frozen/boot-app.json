        "name": "Error",
        "message": "invalid route pattern '/x/:1x': invalid parameter name '1x'"
      }
    },
    {
      "id": "B08-malformed-constraint",
      "declarations": [
        "@Get('/x/:id(\\d+')"
      ],
      "error": {
        "name": "Error",
        "message": "invalid route pattern '/x/:id(\\d+': malformed constraint"
      }
    },
    {
      "id": "B09-same-shape-plain",
      "declarations": [
        "@Get('/users/:id')",
