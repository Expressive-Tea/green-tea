  "data": [
    {
      "id": "B01-duplicate-param",
      "declarations": [
        "@Get('/x/:id/:id')"
      ],
      "error": {
        "name": "Error",
        "message": "invalid route pattern '/x/:id/:id': duplicate parameter 'id'"
      }
    },
    {
      "id": "B02-nonfinal-catch-all",
      "declarations": [
        "@Get('/x/:rest*/tail')"
      ],
      "error": {
        "name": "Error",
        "message": "invalid route pattern '/x/:rest*/tail': catch-all must be the final segment"
      }
    },
    {
      "id": "B03-nested-quantifier",
      "declarations": [
        "@Get('/x/:id((a+)+)')"
      ],
      "error": {
        "name": "Error",
        "message": "unsafe route constraint: unsupported expression '(a+)+'"
      }
    },
    {
      "id": "B04-alternation",
      "declarations": [
        "@Get('/x/:id(a|b)')"
      ],
      "error": {
        "name": "Error",
        "message": "unsafe route constraint: unsupported expression 'a|b'"
      }
    },
    {
      "id": "B05-adjacent-unbounded",
      "declarations": [
        "@Get('/x/:id(\\d+\\w+)')"
      ],
      "error": {
        "name": "Error",
        "message": "unsafe route constraint: adjacent unbounded quantifiers in '\\d+\\w+'"
      }
    },
    {
      "id": "B06-inverted-quantifier",
      "declarations": [
        "@Get('/x/:id(\\d{5,2})')"
